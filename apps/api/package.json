    "db:push": "prisma db push",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@prisma/client": "^5.18.0",
    "argon2": "^0.40.0",
